# PostgreSQL
POSTGRES_USER=quizlive
POSTGRES_PASSWORD=quizlive_dev_password_change_me
POSTGRES_DB=quizlive
POSTGRES_PORT=5432

# Backend API
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=postgres;Port=5432;Database=quizlive;Username=quizlive;Password=quizlive_dev_password_change_me
Jwt__Issuer=QuizLive
Jwt__Audience=QuizLive
Jwt__SigningKey=dev-only-super-secret-signing-key-at-least-32-chars-long!
Jwt__ExpiryMinutes=480
SeedAdmin__Email=admin@quizlive.local
SeedAdmin__Password=ChangeMe123!
SeedAdmin__DisplayName=QuizLive Admin
Cors__AllowedOrigins__0=http://localhost:3000

# Frontend
API_INTERNAL_URL=http://api:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
